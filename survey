        </p>
      </section>
      
      <!-- Healthcare Section -->
      <section class="mt-12">
        <h2 class="text-2xl font-semibold text-foreground md:text-3xl">
          Healthcare
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted-foreground">
